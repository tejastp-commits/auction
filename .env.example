# ===================================================================
# IPL Auction Arena — Environment Configuration Template
# ===================================================================

# -------------------------------------------------------------------
# 1. Vercel Frontend Configuration
# (Set these in your Vercel Project Settings > Environment Variables)
# -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Points the Vercel frontend to your Render backend coordinator:
# (Requests to /api/auction/* and /api/reports/* are seamlessly proxied to Render)
RENDER_BACKEND_URL=https://ipl-auction-arena-api.onrender.com

# -------------------------------------------------------------------
# 2. Supabase Database Configuration
# (Set in both Vercel and Render for direct PostgreSQL / reports queries)
# -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------------
# 3. Render Backend Coordinator Configuration
# (Set in Render Dashboard for your Web Service)
# -------------------------------------------------------------------
PORT=10000
DATA_DIR=./data
CORS_ORIGIN=*

# -------------------------------------------------------------------
# 4. Optional Observability Keys
# -------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_ID=
